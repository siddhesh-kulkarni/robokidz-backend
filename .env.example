# Database (Postgres – local or hosted like Neon)
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/robokidz

# true = fixed sample quiz (no Groq call). false = real AI generation
MOCK_LLM=true

# Only needed when MOCK_LLM=false
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
